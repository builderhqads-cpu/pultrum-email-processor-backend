# ==========================================================================
# Pultrum mail processor — environment template
# Copy to .env and fill in. NEVER commit the real .env (it holds secrets).
# ==========================================================================

# App
NODE_ENV=development
PORT=3000
# Comma-separated allowed CORS origins (frontend URL). Empty = reflect any.
CORS_ORIGINS=
# Code required to self-register an account (/auth/register). Empty = disabled.
REGISTRATION_CODE=

# Database
# Local/docker-compose dev uses the bundled Postgres on port 5433.
# In docker-compose.prod.yml this is overridden to point at the "postgres" service.
POSTGRES_DB=pultrum_mail_processor
POSTGRES_USER=pultrum
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://pultrum:change-me@localhost:5433/pultrum_mail_processor?schema=public

# Redis / BullMQ
# On a managed host (Easypanel) set REDIS_HOST to the service name and provide
# the generated password. Leave password empty for a local passwordless Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_USERNAME=   # only if your Redis uses an ACL user other than "default"

# Seed: admin user (prisma/seed.ts). Set real values before seeding in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Seed mailboxes (optional overrides, used only by prisma/seed.ts)
OPEN_TRANSPORT_MAILBOX=planning@pultrum-rijssen.nl
STUK_GOED_MAILBOX=stukgoed@pultrum-rijssen.nl
TEST_MAILBOX_EMAIL=

# Mail provider: graph | imap
MAIL_PROVIDER=graph

# Mailbox auto-sync interval (the on/off toggle lives in the SystemSettings
# table, managed from the frontend Automation tab — not here).
MAILBOX_SYNC_INTERVAL_SECONDS=60

# Intake folder: when set, the sync reads ONLY this custom folder (e.g. the
# planner's "AI BOB", holding only order emails) instead of the whole Inbox.
# Empty = Inbox. With a folder set, the date cutoff is skipped (everything in the
# folder is processed; dedup prevents repeats). Resolved by display name.
GRAPH_INTAKE_FOLDER=

# Microsoft Graph OAuth (delegated)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "consumers" for personal accounts, or the company tenant ID for org mailboxes.
MS_TENANT_ID=consumers
# Must match the redirect URI registered in the Azure app.
MS_REDIRECT_URI=http://localhost:3000/auth/callback
FRONTEND_SETTINGS_URL=http://localhost:3001/en/settings
GRAPH_CONNECTED_MAILBOX_DEPARTMENT=OPEN_TRANSPORT
# App-only (server-to-server) mailbox access: no interactive OAuth / redirect.
# Uses MS_CLIENT_ID + MS_CLIENT_SECRET + MS_TENANT_ID with Application perms.
# GRAPH_APP_ONLY=true

# IMAP (only used when MAIL_PROVIDER=imap)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_AUTH_TYPE=password
# IMAP_AUTO_CREATE_MAILBOX=true
# IMAP_MAILBOX_DEPARTMENT=OPEN_TRANSPORT

# --- AI: everything goes through the router. This system holds NO AI API key. -
# All AI (classification, extraction, reply) is called on the router, which owns
# the LLM credentials + billing. Point AI_API_BASE_URL at your router.
AI_API_BASE_URL=https://your-model-router.example
AI_REPLY_API_URL=/generate-missing-info-reply
AI_CLASSIFICATION_API_URL=/classify-email
# /eml-process does the whole job (classify + read attachments + split into N
# orders); far slower (a PDF takes minutes), so it gets a larger budget. The
# consolidated missing-info reply (one e-mail per batch) reuses AI_REPLY_API_URL.
AI_EML_PROCESS_API_URL=/eml-process
AI_EML_PROCESS_TIMEOUT_MS=600000
AI_REPLY_TIMEOUT_MS=120000

# New flow: send only the .eml to the router; it classifies + returns the
# order(s), and we just store them. Legacy pipeline stays in code but is bypassed.
AI_EMAIL_ANALYSIS_ENABLED=true

# Deterministic inbound filter (cost): after sync, skip high-confidence non-orders
# (auto-reply, out-of-office, bounce, system sender) BEFORE any AI call. Pure
# rules, no AI; conservative (lets ambiguous emails through). Opt-in.
EMAIL_FILTER_ENABLED=false
# Extra sender substrings to always skip (comma-separated, case-insensitive),
# e.g. a website contact-form address. "noreply@" senders are NOT blocked by
# default — add specific ones here if they are noise.
EMAIL_FILTER_BLOCK_SENDERS=

# Docling text-extraction microservice (PDF/DOCX/XLSX -> structured text). When
# enabled, the backend extracts attachment text via the service. Best-effort:
# if it is off/unreachable the pipeline falls back to current behaviour.
DOCLING_ENABLED=false
# Local (backend on host): http://localhost:8000. Inside a compose/EasyPanel
# network it would be http://docling:8000.
DOCLING_URL=http://localhost:8000
DOCLING_TIMEOUT_MS=120000
# docling table structure: true forces a grid; false gives linear reading-order
# text (often better for dense/irregular planning tables). Read by the docling
# container via compose.
DOCLING_TABLE_STRUCTURE=true
# When attachment text is present, omit the .eml (base64 PDFs) from the router
# payload to shrink it. Turn on ONLY once the router uses attachments[].text.
AI_OMIT_EML_WITH_ATTACHMENTS=false

# Google geocoding enrichment (fills missing pickup/delivery zipcodes before AI
# when enough address context exists in the email body).
GEOCODING_ENABLED=true
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
GEOCODING_TIMEOUT_MS=5000
# Google's partial_match means it could NOT match the street/number and fell back
# to the locality -> the zipcode would be the city centre's. Default: reject.
GEOCODING_ALLOW_PARTIAL_MATCH=false
# In-memory lookup cache (same address is not billed twice).
GEOCODING_CACHE_TTL_MS=86400000
GEOCODING_CACHE_MAX_ENTRIES=5000

# Per-client rules engine (Derix etc.). OFF while the AI handles everything from
# the .eml. Set true to re-enable the deterministic client profiles.
CLIENT_PROFILE_ENABLED=false

# Batch split via the router (our own OpenRouter fallback has been removed).
BATCH_SPLIT_AI_ENABLED=false
# Batch orders are always filled; this only auto-enqueues their XML/reply jobs.
# OFF avoids mass auto-replies/XML while testing.
BATCH_ENQUEUE_JOBS_ENABLED=false

# Creative Gears (carrier delivery target). Empty = mock mode.
CREATIVE_GEARS_API_URL=
CREATIVE_GEARS_USERNAME=
CREATIVE_GEARS_PASSWORD=
# Include the <documents> block (original .eml + attachments as base64) in the
# XML. It can be several MB and may crash the Transpas import (HTTP 500). Set to
# false to omit it. Default when unset: true.
CREATIVE_GEARS_INCLUDE_DOCUMENTS=true
# customer_id (klantnummer) required: when true, an order without it is "missing"
# (never "Ready for XML") and the XML builder enforces the same rule.
CREATIVE_GEARS_REQUIRE_CUSTOMER_ID=true
# EDI provider number: routes the order stream to a dedicated Transpas intake,
# separate from the existing couplings. Pultrum = 98; changes per Pultrum
# company. Default when unset: 98.
CREATIVE_GEARS_EDI_PROVIDER=98

# Parties Pultrum never transports: orders whose delivery_name or pickup_name
# contains one of these (comma-separated, case-insensitive) are dropped before
# becoming an order (Niek's Derix rule for Withagen). Default when unset:
# withagen.
ORDER_EXCLUDE_PARTY_NAMES=withagen

# Max attachment size (MB) to download from Graph. Default 15.
ATTACHMENT_MAX_MB=15

# Reply / outbound email
EMAIL_SEND_PROVIDER=graph
